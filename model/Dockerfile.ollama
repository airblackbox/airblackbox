##
## Custom Ollama image with AIR Blackbox compliance model pre-loaded.
## No internet required at runtime — the model ships inside the image.
##
## The build context is this directory (model/), not the repository root:
## the root .dockerignore leaves model/ out of every root-context build.
##
## Build (docker-compose.enterprise.yaml and deploy-enterprise.sh do this):
##   place the fine-tuned GGUF at model/air-compliance-v3.gguf, then
##   docker build -f model/Dockerfile.ollama -t localhost/air-blackbox/ollama-compliance:v3 model
##
## The localhost/ prefix keeps the tag local: Docker never pulls it from
## Docker Hub, where the "airblackbox" namespace belongs to someone else.
##

FROM ollama/ollama:latest

# Copy the fine-tuned GGUF model into the image
COPY air-compliance-v3.gguf /model/air-compliance-v3.gguf
COPY Modelfile /model/Modelfile

# Pre-load the model into Ollama on build
# This starts Ollama temporarily, creates the model, then stops.
RUN bash -c '\
    ollama serve & \
    SERVER_PID=$!; \
    sleep 5; \
    ollama create air-compliance -f /model/Modelfile; \
    kill $SERVER_PID; \
    wait $SERVER_PID 2>/dev/null; \
    echo "Model air-compliance baked into image."'

EXPOSE 11434
ENTRYPOINT ["ollama", "serve"]
